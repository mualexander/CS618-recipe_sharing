# Used by docker compose. Copy to .env and fill in.
# Docker Hub username, used to tag images for `docker compose push`
DOCKERHUB_USER=
# Leave unset to use the local mongo container, or set to an Atlas connection string
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/recipe-sharing?retryWrites=true&w=majority
# Host port for the local mongo container (change if 27017 is already in use)
# MONGO_PORT=27018
